{
  "name": "gedcom-mrt-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for GEDCOM Repair: accounts, Stripe licensing, and zero-knowledge file storage.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --target node26 --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@google-cloud/firestore": "^9.4.1",
    "@google-cloud/storage": "^8.4.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
